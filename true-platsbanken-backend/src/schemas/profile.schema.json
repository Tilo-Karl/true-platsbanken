{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "userId",
    "name",
    "email",
    "phone",
    "municipality",
    "employmentType",
    "skills",
    "cvText",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "userId": { "type": "string" },
    "name": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "phone": { "type": "string" },
    "municipality": { "type": "string" },
    "employmentType": {
      "type": "string",
      "enum": ["full_time", "part_time", "any"]
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cvText": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
