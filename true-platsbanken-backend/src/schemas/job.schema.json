{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "url",
    "title",
    "description",
    "employerName",
    "municipality",
    "publishedAt",
    "employmentType",
    "remotePossible"
  ],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string", "const": "platsbanken" },
    "url": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "employerName": { "type": "string" },
    "municipality": { "type": "string" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "employmentType": {
      "type": "string",
      "enum": ["full_time", "part_time", "unknown"]
    },
    "employmentTypeLabel": { "type": ["string", "null"] },
    "durationLabel": { "type": ["string", "null"] },
    "scopeOfWork": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "label": { "type": ["string", "null"] }
      }
    },
    "applicationDeadline": { "type": ["string", "null"] },
    "numberOfVacancies": { "type": ["number", "null"] },
    "occupationLabel": { "type": ["string", "null"] },
    "remotePossible": { "type": ["boolean", "null"] }
  }
}
