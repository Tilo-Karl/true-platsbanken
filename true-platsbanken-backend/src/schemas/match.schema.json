{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "profileId",
    "jobId",
    "score",
    "reasons",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "profileId": { "type": "string" },
    "jobId": { "type": "string" },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
